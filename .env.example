# Compose-level Postgres credentials only.
# App secrets (JWT_SECRET, SMTP_*, CLOUDINARY_*, ANTHROPIC_API_KEY, STRIPE_*, ...)
# stay in each app repo's own .env / .env.local — see docker-compose.yml comments.
POSTGRES_USER=veganfit
POSTGRES_PASSWORD=veganfit
POSTGRES_DB=veganfit
# Host-side port only (defaults to 5433, not 5432, to avoid clashing with any other
# local Postgres). Containers always reach this one at postgres:5432 internally.
POSTGRES_PORT=5433
